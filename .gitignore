# ============ 环境变量 ============
.env
.env.local
.env.*.local

# ============ 本地数据卷（Docker 挂载，含 MySQL 数据）============
volumes/

# ============ 个人文件（简历等，勿公开）============
output/

# ============ 依赖包 ============
node_modules/
.pnpm-store/
.npm

# ============ 日志 ============
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ============ 操作系统 ============
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============ 编辑器 ============
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.swn
*~

# ============ 临时文件 ============
*.tmp
*.temp
.cache/
.temp/
tmp/
temp/

# ============ 归档/大文件 ============
# 超过 GitHub 100MB 限制，不应提交
*.tar
public/assets.tar

# ============ 素材（可选：如果不想提交图片和音乐请取消注释）========
# public/assets/images/*
# public/assets/audio/*
# 保留 .gitkeep
# !public/assets/images/.gitkeep
# !public/assets/audio/.gitkeep

# ============ EPUB 源文件（可选）============
# *.epub

# ============ 证书（服务器专属文件，严禁提交 git）============
# 本地自签证书也放在这里（openssl 生成，浏览器会提示不安全属正常）
deploy/certs/

# ============ 本地 compose 覆盖（含本机端口映射，服务器不适用）============
docker-compose.override.yml

