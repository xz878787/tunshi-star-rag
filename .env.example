# ============ 大语言模型配置 ============
# 模型名称（例：qwen-plus / qwen-max / qwen-turbo）
MODEL_NAME=qwen-plus

# DashScope（阿里云百炼）API Key
# 获取地址：https://dashscope.console.aliyun.com/apiKey
OPENAI_API_KEY=sk-你的_DashScope_API_Key

# DashScope 兼容模式 API 地址（固定）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 向量模型配置 ============
# 向量嵌入模型名称（固定为 text-embedding-v3）
EMBEDDINGS_MODEL_NAME=text-embedding-v3

# ============ Milvus / Zilliz Cloud 配置 ============
# Zilliz Cloud 公网连接地址
# 获取地址：https://cloud.zilliz.com.cn/
MILVUS_ADDRESS=https://你的集群地址.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn

# Zilliz Cloud API Token
MILVUS_TOKEN=你的_Zilliz_Token

# ============ MySQL 数据库配置 ============
# Docker 部署时使用现有容器名和容器端口；本机直连才使用 127.0.0.1:3307
DB_HOST=rag-mysql8
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的_MySQL_密码
DB_NAME=rag_system

# ============ JWT 密钥 ============
# 生产环境务必替换为高强度随机字符串
JWT_SECRET=你的_JWT_密钥
JWT_EXPIRES_IN=2h
