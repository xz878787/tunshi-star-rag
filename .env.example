# ============ 大语言模型配置 ============
# 模型名称（例：qwen-plus / qwen-max / qwen-turbo）
MODEL_NAME=qwen-plus

# DashScope（阿里云百炼）API Key
# 获取地址：https://dashscope.console.aliyun.com/apiKey
OPENAI_API_KEY=sk-你的_DashScope_API_Key

# DashScope 兼容模式 API 地址（固定）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 向量模型配置 ============
# 向量嵌入模型名称（固定为 text-embedding-v3）
EMBEDDINGS_MODEL_NAME=text-embedding-v3

# ============ 检索增强（宽召回 → RRF 融合 → 重排）============
# 重排服务地址：必须是 DashScope 原生 text-rerank 协议（compatible-mode/v1/reranks 会 404）
# 未配置时重排自动停用（只打印一行告警），检索退化为纯向量 Top-K
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-rerank
# 重排总开关：排查线上问题时置 false 一键回退
RERANK_ENABLED=true
# 宽召回候选条数（也是融合后送进重排器的条数）：设 5 即等于关闭宽召回、行为回到改造前
RERANK_CANDIDATE_K=15
# 重排后保留条数；不配则回落到每轮检索条数 k（即 5）
# RERANK_TOP_N=5

# 查询改写开关：默认 false。开=每条子问题由 planModel 生成 1~5 条多角度问句，各自走双通道召回后 RRF 融合
# 代价：每轮检索 +1 次小模型调用、每通道多 N 次召回；失败自动降级为只检索原问题
QUERY_AUGMENT_ENABLED=false
# 改写条数（不含原问题，1~5，超出按 5 计）
AUGMENT_QUERY_COUNT=3

# ============ 混合检索：稀疏路（进程内 BM25，零外部依赖）============
# 启动时从 EPUB 重算切片并构建纯 JS BM25 倒排索引（约 2.4s），无需安装 ES
# memory（默认）：开启稀疏路；none：完全关闭稀疏路（= 改造前纯向量，供 A/B 对照与回退）
SPARSE_BACKEND=memory

# ============ Milvus / Zilliz Cloud 配置 ============
# Zilliz Cloud 公网连接地址
# 获取地址：https://cloud.zilliz.com.cn/
MILVUS_ADDRESS=https://你的集群地址.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn

# Zilliz Cloud API Token
MILVUS_TOKEN=你的_Zilliz_Token

# ============ MySQL 数据库配置 ============
# Docker 部署时使用现有容器名和容器端口；本机直连才使用 127.0.0.1:3307
DB_HOST=rag-mysql8
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的_MySQL_密码
DB_NAME=rag_system

# ============ JWT 密钥 ============
# 生产环境务必替换为高强度随机字符串
JWT_SECRET=你的_JWT_密钥
JWT_EXPIRES_IN=2h
